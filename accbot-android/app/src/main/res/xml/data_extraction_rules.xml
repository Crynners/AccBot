<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="accbot_credentials.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml"/>
        <exclude domain="database" path="accbot_prod.db"/>
        <exclude domain="database" path="accbot_prod.db-wal"/>
        <exclude domain="database" path="accbot_prod.db-shm"/>
        <exclude domain="database" path="accbot_sandbox.db"/>
        <exclude domain="database" path="accbot_sandbox.db-wal"/>
        <exclude domain="database" path="accbot_sandbox.db-shm"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="accbot_credentials.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml"/>
        <exclude domain="database" path="accbot_prod.db"/>
        <exclude domain="database" path="accbot_prod.db-wal"/>
        <exclude domain="database" path="accbot_prod.db-shm"/>
        <exclude domain="database" path="accbot_sandbox.db"/>
        <exclude domain="database" path="accbot_sandbox.db-wal"/>
        <exclude domain="database" path="accbot_sandbox.db-shm"/>
    </device-transfer>
</data-extraction-rules>
