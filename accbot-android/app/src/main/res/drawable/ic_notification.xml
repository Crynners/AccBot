        android:fillColor="#FFFFFF"
        android:pathData="M12.5,3 h1.2 v2 h-1.2 z M15,3 h1.2 v2 h-1.2 z"/>

    <!-- ₿ bottom serifs -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,19 h1.2 v2 h-1.2 z M15,19 h1.2 v2 h-1.2 z"/>

</vector>
