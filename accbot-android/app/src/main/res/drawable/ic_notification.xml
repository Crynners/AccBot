        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M10,12 h7 a3.5,3.5 0 0,1 0,7 h-7 z M12,14 h3 a1.5,1.5 0 0,1 0,3 h-3 z"/>

    <!-- ₿ top serifs -->
