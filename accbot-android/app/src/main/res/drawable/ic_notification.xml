        android:fillColor="#FFFFFF"
        android:pathData="M1,19 L7,16 L7,17.8 L4.2,19 L7,20.2 L7,22 Z"/>

    <!-- First "c" rotated — ∪ arch, curve at bottom, opening upward (y:9.5-14.5) -->
