        android:fillColor="#FFFFFF"
        android:pathData="M1.5,3 C1.5,8 6.5,8 6.5,3 L5,3 C5,6.5 3,6.5 3,3 Z"/>

    <!-- ₿ upper bump with counter (hole inside B) -->
