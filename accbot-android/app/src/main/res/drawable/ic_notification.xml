        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M10,5 h6 a3.5,3.5 0 0,1 0,7 h-6 z M12,7 h2.5 a1.5,1.5 0 0,1 0,3 h-2.5 z"/>

    <!-- ₿ lower bump with counter (slightly wider) -->
