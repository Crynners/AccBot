        android:fillColor="#FFFFFF"
        android:pathData="M1.5,9.5 C1.5,14.5 6.5,14.5 6.5,9.5 L5,9.5 C5,13 3,13 3,9.5 Z"/>

    <!-- Second "c" rotated — ∪ arch, curve at bottom, opening upward (y:3-8) -->
